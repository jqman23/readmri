# Copy this file to .env.local and paste your real API key there.
# Never commit real API keys, even in private repositories.

# Pick one provider. Use groq if your OpenAI key is out of quota.
AI_PROVIDER=groq

# Groq option: create a key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# OpenAI option: switch AI_PROVIDER=openai and add your OpenAI key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1

# Backward-compatible optional override used if provider-specific model is unset.
AI_MODEL=
